@page "/gioi-thieu"
@inject ContentService Content
@inject NavigationManager Navigation

<HeadContent>
    <title>Giới thiệu · BA ĐỘNG — Coastal Escape</title>
    <meta name="description" content="Khám phá chiều sâu lịch sử, hệ sinh thái phù sa độc bản và nét đẹp mộc mạc của bờ biển Ba Động, Trà Vinh." />
</HeadContent>

<!-- HERO SECTION: EDITORIAL COASTAL ATMOSPHERE -->
<section class="page-hero">
    <div class="container-wide">
        <Breadcrumbs Items="breadcrumbs" />
        <p class="eyebrow">Địa danh di sản · Bờ biển Duyên Hải</p>
        <h1>Ba Động: Nơi phù sa Cửu Long gặp sóng gió biển Đông.</h1>
        <p>Không phải khu nghỉ dưỡng thương mại xô bồ. Ba Động là câu chuyện của dải cát bồi hơn 12 cây số, rặng phi lao cổ thụ chắn gió mặn, và nhịp sống tự nhiên của những người con gắn bó cùng biển cả qua nhiều thế hệ.</p>

        <!-- FIELD DOSSIER BADGES -->
        <div class="about-hero-dossier" aria-label="Thông số thực địa Ba Động">
            <div class="about-dossier-pill">
                <span class="about-dossier-pill__icon" aria-hidden="true">📍</span>
                <div>
                    <span class="about-dossier-pill__label">Tọa độ tiếp cận</span>
                    <span class="about-dossier-pill__value">9°40'25" N · 106°34'12" E</span>
                </div>
            </div>
            <div class="about-dossier-pill">
                <span class="about-dossier-pill__icon" aria-hidden="true">🌊</span>
                <div>
                    <span class="about-dossier-pill__label">Bờ cát phù sa</span>
                    <span class="about-dossier-pill__value">12+ km thoai thoải</span>
                </div>
            </div>
            <div class="about-dossier-pill">
                <span class="about-dossier-pill__icon" aria-hidden="true">🌲</span>
                <div>
                    <span class="about-dossier-pill__label">Vành đai chắn sóng</span>
                    <span class="about-dossier-pill__value">500+ ha rừng phi lao</span>
                </div>
            </div>
            <div class="about-dossier-pill">
                <span class="about-dossier-pill__icon" aria-hidden="true">🌬️</span>
                <div>
                    <span class="about-dossier-pill__label">Năng lượng sạch</span>
                    <span class="about-dossier-pill__value">48 tua-bin ngoài khơi</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SECTION 1: BỐI CẢNH & TINH THẦN ĐI CHẬM -->
<section class="page-section surface-sand">
    <div class="container-wide editorial-split">
        <div class="editorial-split__copy">
            <p class="eyebrow">Bối cảnh địa lý & Văn hóa</p>
            <h2>Biển, đồng bằng và một nhịp sống khác.</h2>
            <p>Ba Động tọa lạc tại xã Trường Long Hòa, thị xã Duyên Hải. Đây là dải đất ven biển độc đáo nơi dòng chảy của hệ thống sông Cửu Long vươn mình ra đại dương bao la. Một chuyến đi về Ba Động không cần phải vội vã tích điểm check-in; nơi đây cần bạn chậm lại một nhịp để lắng nghe tiếng gió biển và quan sát nhịp sống đời thường.</p>
            <p>Khác với những bãi biển miền Trung với núi non hiểm trở hay bãi cát trắng phau, Ba Động mang sắc nâu đằm thắm của phù sa màu mỡ. Đó là vùng đất nuôi dưỡng nguồn lợi thủy hải sản trù phú bậc nhất đồng bằng, đồng thời lưu giữ dấu ấn giao thoa văn hóa lâu đời giữa ba cộng đồng Kinh, Khmer và Hoa.</p>
            <div class="button-row" style="margin-top: 24px;">
                <NavLink class="button button--primary" href="cam-nang">Xem cẩm nang trải nghiệm</NavLink>
                <NavLink class="button button--ghost" href="kham-pha">Các điểm đến lân cận</NavLink>
            </div>
        </div>
        <div class="editorial-split__image">
            <img src="images/locations/ba-dong-beach-1600.jpg"
                 srcset="images/locations/ba-dong-beach-800.jpg 960w, images/locations/ba-dong-beach-1600.jpg 1920w"
                 sizes="(max-width: 820px) 88vw, 45vw"
                 alt="Toàn cảnh biển Ba Động với bãi cát trải dài, bờ biển phẳng lặng và cụm điện gió xa xa"
                 loading="lazy"
                 decoding="async"
                 width="1600"
                 height="900" />
            <a class="image-credit" href="https://commons.wikimedia.org/wiki/File:Bi%E1%BB%83n_Ba_%C4%90%E1%BB%99ng,_Tr%C3%A0_Vinh.jpg" target="_blank" rel="noreferrer">
                Baoothersks · CC BY 4.0 ↗
            </a>
        </div>
    </div>
</section>

<!-- SECTION 2: NGUỒN GỐC ĐỊA DANH & HUYỀN TÍCH 3 ĐỘNG CÁT -->
<section class="page-section surface-foam">
    <div class="container-wide">
        <div class="section-heading">
            <p class="eyebrow">Lịch sử & Tên gọi</p>
            <h2>Vì sao vùng đất này mang tên "Ba Động"?</h2>
            <p>Cái tên "Ba Động" không phải là một sự ngẫu nhiên, mà bắt nguồn từ chính địa hình đụn cát tự nhiên được hình thành qua hàng thế kỷ kiến tạo phù sa và sóng biển.</p>
        </div>

        <div class="heritage-grid">
            <article class="heritage-card">
                <span class="heritage-card__badge">Động thứ nhất</span>
                <h3>Động Cát Ngoài</h3>
                <p>Nằm sát mép biển, chịu ảnh hưởng trực tiếp của từng đợt thủy triều lên xuống. Đây chính là bờ biển Ba Động ngày nay, nơi đón nhận nguồn phù sa dồi dào từ biển Đông bồi đắp bãi cát thoai thoải phẳng lì.</p>
                <span class="heritage-card__tag">🌊 Tuyến du lịch bờ biển hiện đại</span>
            </article>

            <article class="heritage-card">
                <span class="heritage-card__badge">Động thứ hai</span>
                <h3>Động Cát Giữa</h3>
                <p>Nằm sâu hơn vào đất liền, là dải giồng cát cao ráo, màu mỡ nhờ sự hòa quyện giữa đất cát và khoáng chất biển. Đây là nơi nuôi trồng các loại nông sản nức tiếng như dưa hấu Ba Động vỏ mỏng ngọt thanh, khoai lang và hành tím.</p>
                <span class="heritage-card__tag">🍉 Giồng cát nông nghiệp trù phú</span>
            </article>

            <article class="heritage-card">
                <span class="heritage-card__badge">Động thứ ba</span>
                <h3>Động Cát Trong</h3>
                <p>Dải cồn cát cổ nhất nép mình bên những xóm ấp bình yên, được bao bọc bởi rặng phi lao cổ thụ và các rạch nước mặn. Đây là nơi tụ cư đầu tiên của những lưu dân khai hoang mở cõi và lập nên làng biển Duyên Hải.</p>
                <span class="heritage-card__tag">🏡 Không gian định cư & di sản làng biển</span>
            </article>
        </div>

        <div class="heritage-callout">
            <span class="heritage-callout__icon" aria-hidden="true">🏛️</span>
            <div class="heritage-callout__text">
                <h4>Ghi chép lịch sử đầu thế kỷ 20</h4>
                <p>Từ những năm 1920 thời kỳ Pháp thuộc, chính quyền đương thời đã khảo sát dọc bờ biển Nam Kỳ và quyết định chọn Ba Động làm nơi xây dựng khu nghỉ dưỡng, phục hồi sức khỏe cho các quan chức nhờ vi khí hậu ôn hòa quanh năm và hàng phi lao che chắn gió bão tự nhiên.</p>
            </div>
        </div>
    </div>
</section>

<!-- SECTION 3: BA CHIỀU KÍCH TRẢI NGHIỆM THỰC ĐỊA -->
<section class="page-section surface-sand">
    <div class="container-wide">
        <div class="section-heading">
            <p class="eyebrow">Ba nhịp cảm xúc thực địa</p>
            <h2>Chạm vào Ba Động bằng mọi giác quan.</h2>
            <p>Từng khoảnh khắc trong ngày tại bờ biển này mang lại một rung cảm rất riêng — từ tiếng rặng dương buổi sớm đến hoàng hôn buông xuống cánh đồng điện gió.</p>
        </div>

        <div class="sensory-grid">
            <!-- Story 1: Hàng dương -->
            <article class="sensory-card">
                <figure class="sensory-card__figure">
                    <img src="images/locations/ba-dong-casuarina-1600.jpg"
                         srcset="images/locations/ba-dong-casuarina-800.jpg 800w, images/locations/ba-dong-casuarina-1600.jpg 1600w"
                         sizes="(max-width: 820px) 100vw, 33vw"
                         alt="Rừng phi lao xanh mướt trải dài ven bờ biển chắn gió chắn sóng"
                         loading="lazy"
                         decoding="async" />
                    <a class="sensory-card__credit" href="https://commons.wikimedia.org/wiki/File:Casuarina_equesitifolia_tree.jpg" target="_blank" rel="noreferrer">
                        Wikimedia · CC BY 3.0 ↗
                    </a>
                </figure>
                <div class="sensory-card__body">
                    <span class="sensory-card__tag">🌲 Thị giác & Thính giác</span>
                    <h3>Hàng dương cổ thụ chắn sóng</h3>
                    <p>Hàng phi lao ngút ngàn chạy dọc bờ biển hơn 12 cây số như một trường thành tự nhiên xanh mát. Dưới bóng râm rười rượi, tiếng lá reo vi vu cùng tiếng sóng vỗ tạo nên bản hòa thanh êm ả xua tan mọi áp lực đô thị.</p>
                </div>
            </article>

            <!-- Story 2: Làng chài -->
            <article class="sensory-card">
                <figure class="sensory-card__figure">
                    <img src="images/locations/coastal-life-boats-1600.jpg"
                         srcset="images/locations/coastal-life-boats-800.jpg 800w, images/locations/coastal-life-boats-1600.jpg 1600w"
                         sizes="(max-width: 820px) 100vw, 33vw"
                         alt="Thuyền thúng truyền thống và ghe đánh bắt cá của ngư dân trên bờ biển"
                         loading="lazy"
                         decoding="async" />
                    <a class="sensory-card__credit" href="https://commons.wikimedia.org/wiki/File:Coracle_fishing_boats_in_Vietnam_02.jpg" target="_blank" rel="noreferrer">
                        Wikimedia · CC BY-SA 2.0 ↗
                    </a>
                </figure>
                <div class="sensory-card__body">
                    <span class="sensory-card__tag">⛵ Nhịp sống & Đời thường</span>
                    <h3>Bến thuyền thúng & Nghề biển</h3>
                    <p>Mỗi sớm mai khi triều rút, bãi biển Ba Động trở thành bến đậu của những chiếc thuyền thúng tròn mộc mạc. Ngư dân trở về với mẻ lưới đầy ắp cua biển, cá khoai, tôm bạc và chù ụ tươi rói còn vương mặn mòi gió khơi.</p>
                </div>
            </article>

            <!-- Story 3: Điện gió -->
            <article class="sensory-card">
                <figure class="sensory-card__figure">
                    <img src="images/locations/duyen-hai-wind-power-1600.jpg"
                         srcset="images/locations/duyen-hai-wind-power-800.jpg 800w, images/locations/duyen-hai-wind-power-1600.jpg 1600w"
                         sizes="(max-width: 820px) 100vw, 33vw"
                         alt="Cụm tua-bin điện gió vươn cao trên biển Duyên Hải dưới ánh chiều hoàng hôn"
                         loading="lazy"
                         decoding="async" />
                    <a class="sensory-card__credit" href="https://commons.wikimedia.org/wiki/File:Th%E1%BB%8B_x%C3%A3_Duy%C3%AAn_H%E1%BA%A3i.jpg" target="_blank" rel="noreferrer">
                        Dangkhoadora · CC BY-SA 4.0 ↗
                    </a>
                </figure>
                <div class="sensory-card__body">
                    <span class="sensory-card__tag">🌬️ Hơi thở hiện đại</span>
                    <h3>Điện gió ngoài khơi Duyên Hải</h3>
                    <p>Những cánh quạt khổng lồ vươn lên giữa làn nước bạc biểu trưng cho sự chuyển mình bền vững của vùng biển duyên hải. Vào thời khắc hoàng hôn, ánh chiều buông xuống nhuộm tím đường chân trời phản chiếu qua từng vòng quay tua-bin.</p>
                </div>
            </article>
        </div>
    </div>
</section>

<!-- SECTION 4: GIẢI MÃ ĐẶC TÍNH PHÙ SA CỬU LONG -->
<section class="page-section surface-foam">
    <div class="container-wide">
        <div class="section-heading">
            <p class="eyebrow">Sinh thái & Sự thật bản địa</p>
            <h2>Vì sao nước biển Ba Động mang màu phù sa?</h2>
            <p>Khác biệt lớn nhất làm nên linh hồn của Ba Động nằm ở đặc tính dòng nước. Thay vì tìm kiếm một màu nước ngọc bích nhân tạo, hãy nhìn nhận vẻ đẹp của dòng phù sa như một mạch nguồn nuôi sống cả vùng đất.</p>
        </div>

        <div class="ecology-grid">
            <article class="ecology-card">
                <div class="ecology-card__icon-wrap" aria-hidden="true">🌾</div>
                <div class="ecology-card__content">
                    <h3>Trầm tích chín nhánh sông Rồng</h3>
                    <p>Tọa lạc giữa hai cửa sông lớn là Cung Hầu (sông Tiền) và Định An (sông Hậu), bờ biển Ba Động là nơi tiếp nhận hàng triệu mét khối phù sa màu mỡ từ thượng nguồn sông Mekong đổ về mỗi năm.</p>
                    <ul class="ecology-card__bullets">
                        <li>Hàm lượng khoáng chất và phiêu sinh vật dồi dào bậc nhất Nam Bộ.</li>
                        <li>Tạo môi trường sinh trưởng lý tưởng cho cá khoai, cua biển, tôm sú tự nhiên.</li>
                        <li>Bãi cát nén chặt mịn màng, nâng đỡ bước chân không bị lún sụt.</li>
                    </ul>
                </div>
            </article>

            <article class="ecology-card">
                <div class="ecology-card__icon-wrap" aria-hidden="true">🛡️</div>
                <div class="ecology-card__content">
                    <h3>Lá chắn sinh thái rừng phòng hộ</h3>
                    <p>Địa hình duyên hải Trà Vinh không có núi non che chắn, vì vậy hơn 500 hécta rừng dương và đai rừng ngập mặn ven biển chính là "bức tường thành xanh" kiên cường bảo vệ cuộc sống con người.</p>
                    <ul class="ecology-card__bullets">
                        <li>Ngăn chặn hiện tượng xâm thực bờ biển và cát bay lấn ruộng vườn.</li>
                        <li>Hạ nhiệt độ không khí từ 2 - 3°C so với khu vực trảng cát trống.</li>
                        <li>Nơi trú ngụ sinh sôi của nhiều loài chim biển và hải sản ven bờ.</li>
                    </ul>
                </div>
            </article>
        </div>
    </div>
</section>

<!-- SECTION 5: ĐỊNH HƯỚNG THỰC ĐỊA & BẢN ĐỒ TỌA ĐỘ -->
<section class="page-section surface-sand">
    <div class="container-wide">
        <div class="section-heading">
            <p class="eyebrow">Định hướng thực địa</p>
            <h2>Nhìn Ba Động từ một điểm đứng vừa đủ.</h2>
            <p>Bản đồ địa hình và tọa độ chính xác tại xã Trường Long Hòa, thị xã Duyên Hải. Kiểm tra cung đường tiếp cận và khoảng cách trước khi xuất phát.</p>
        </div>

        <div class="location-card">
            <!-- MAP SIDE -->
            <div class="location-card__map" role="img" aria-label="Bản đồ địa hình bờ biển Ba Động và tọa độ thực tế">
                <div class="map-grid-overlay" aria-hidden="true"></div>
                <div class="map-compass" aria-hidden="true">
                    <span class="map-compass__needle">▲</span>
                    <span>BẮC</span>
                </div>
                <div class="map-pin-container" aria-hidden="true">
                    <div class="map-beacon-ring"></div>
                    <div class="map-beacon-ring map-beacon-ring--delayed"></div>
                    <div class="map-pin-marker">
                        <div class="map-pin-marker__inner"></div>
                    </div>
                    <div class="map-pin-tooltip">
                        <span class="map-pin-tooltip__title">📍 BÃI BIỂN BA ĐỘNG</span>
                        <span class="map-pin-tooltip__coords">9°40'25" N · 106°34'12" E</span>
                    </div>
                </div>
                <div class="map-hud-bar" aria-hidden="true">
                    <span>BẢN ĐỒ ĐỊA HÌNH ESRI</span>
                    <span>── TỈ LỆ 1:50.000 ──</span>
                    <span>ĐIỆN GIÓ NGOÀI KHƠI ↗</span>
                </div>
            </div>

            <!-- INFO SIDE -->
            <div>
                <p class="eyebrow">Tọa độ tiếp cận</p>
                <h2>Biển Ba Động</h2>
                <p class="location-card__address">
                    <span aria-hidden="true">📍</span> @siteInfo.AdministrativeLocation
                </p>

                <!-- DISTANCE SUMMARY CARDS -->
                <div class="location-routes-grid" aria-label="Khoảng cách di chuyển ước tính">
                    <div class="location-route-item">
                        <span class="location-route-item__city">TP. Trà Vinh</span>
                        <span class="location-route-item__stat">~55 km</span>
                        <span class="location-route-item__detail">1h15p · QL53 & TL914</span>
                    </div>
                    <div class="location-route-item">
                        <span class="location-route-item__city">TP. Cần Thơ</span>
                        <span class="location-route-item__stat">~130 km</span>
                        <span class="location-route-item__detail">3h00p · Qua QL54/QL53</span>
                    </div>
                    <div class="location-route-item">
                        <span class="location-route-item__city">TP. Hồ Chí Minh</span>
                        <span class="location-route-item__stat">~185 km</span>
                        <span class="location-route-item__detail">4h00p · Cầu Cổ Chiên</span>
                    </div>
                </div>

                <div class="location-card__highlights">
                    <div class="location-card__point">
                        <span class="location-card__point-icon" aria-hidden="true">🌊</span>
                        <div>
                            <strong>Bờ biển tự nhiên</strong>
                            <p>Dải bờ phù sa êm đềm dài hơn 12 km rợp bóng phi lao chắn sóng biển Đông.</p>
                        </div>
                    </div>
                    <div class="location-card__point">
                        <span class="location-card__point-icon" aria-hidden="true">💨</span>
                        <div>
                            <strong>Tọa độ điện gió</strong>
                            <p>Cụm tua-bin vươn ra mặt nước tạo nên đường nét công nghiệp hiện đại giữa biển trời.</p>
                        </div>
                    </div>
                    <div class="location-card__point">
                        <span class="location-card__point-icon" aria-hidden="true">🧭</span>
                        <div>
                            <strong>Đường đi thông suốt</strong>
                            <p>Điểm cuối Tỉnh lộ 914, đường trải nhựa phẳng dẫn thẳng ra bờ cát mịn.</p>
                        </div>
                    </div>
                </div>

                <div class="button-row">
                    <a class="button button--primary" href="@siteInfo.MapUrl" target="_blank" rel="noreferrer">
                        Mở Google Maps chỉ đường <span aria-hidden="true">↗</span>
                    </a>
                    <NavLink class="button button--ghost" href="cam-nang#di-chuyen">
                        Xem cẩm nang di chuyển
                    </NavLink>
                </div>
                <p class="source-note" style="margin-top: 20px;">
                    Cập nhật tọa độ thực địa: @siteInfo.UpdatedAt
                </p>
            </div>
        </div>
    </div>
</section>

<!-- SECTION 6: QUY ƯỚC VĂN HÓA & TRIẾT LÝ ĐI CHẬM -->
<section class="page-section surface-ocean">
    <div class="container-wide">
        <div class="section-heading">
            <p class="eyebrow">Du lịch có trách nhiệm</p>
            <h2>Đi nhẹ qua một vùng đất đang sống.</h2>
            <p>Không để lại rác thải, không xâm phạm khu vực sinh sống của ngư dân và không biến đời sống bản địa thành phông nền chụp ảnh. Một hành trình ý nghĩa là khi bạn để lại sự tôn trọng và mang về sự thấu hiểu.</p>
        </div>

        <div class="manifesto-grid">
            <article class="manifesto-card">
                <span class="manifesto-card__num">01 / MÔI TRƯỜNG</span>
                <h3>Giữ sạch bãi bồi</h3>
                <p>Tuyệt đối không xả rác bừa bãi. Mang toàn bộ túi nilông và chai nhựa rời khỏi bãi cát để bảo vệ loài còng gió, ốc đụn và chim di cư ven biển.</p>
            </article>

            <article class="manifesto-card">
                <span class="manifesto-card__num">02 / CỘNG ĐỒNG</span>
                <h3>Tôn trọng ngư cụ</h3>
                <p>Không dẫm đạp lên lưới cá, thuyền thúng hay ngư cụ phơi trên bờ. Tránh gây cản trở khi ngư dân đang tập trung kéo lưới cập bến.</p>
            </article>

            <article class="manifesto-card">
                <span class="manifesto-card__num">03 / ỨNG XỬ</span>
                <h3>Xin phép khi chụp ảnh</h3>
                <p>Mở lời chào lịch sự và nhận được sự đồng thuận trước khi chụp ảnh người dân bản địa, đặc biệt là người già và trẻ nhỏ trong làng chài.</p>
            </article>

            <article class="manifesto-card">
                <span class="manifesto-card__num">04 / ẨM THỰC</span>
                <h3>Ăn theo mùa biển</h3>
                <p>Thưởng thức hải sản theo mùa đánh bắt tự nhiên. Hỏi han nguồn gốc đánh bắt và giá cả trước khi dùng bữa với thái độ trân quý sản vật biển.</p>
            </article>
        </div>

        <div style="margin-top: 48px;">
            <SourceNote Urls="sourceUrls" />
        </div>
    </div>
</section>

@code {
    private readonly IReadOnlyList<Breadcrumbs.BreadcrumbItem> breadcrumbs = [new("Giới thiệu")];
    private SiteInfo siteInfo = new();
    private readonly IReadOnlyList<string> sourceUrls = ["https://vietnamtourism.gov.vn/", "https://travinh.gov.vn/"];

    protected override async Task OnInitializedAsync()
    {
        siteInfo = await Content.GetSiteInfoAsync();
    }
}
