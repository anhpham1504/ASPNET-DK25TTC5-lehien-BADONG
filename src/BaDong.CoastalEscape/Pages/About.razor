@page "/gioi-thieu"
@inject ContentService Content
@inject NavigationManager Navigation
<HeadContent><title>Giới thiệu · BA ĐỘNG — Coastal Escape</title><meta name="description" content="Câu chuyện về biển Ba Động, vùng ven biển Trà Vinh và tinh thần đi chậm." /></HeadContent>

<section class="page-hero"><div class="container-wide"><Breadcrumbs Items="breadcrumbs" /><p class="eyebrow">Giới thiệu</p><h1>Một vùng biển được kể bằng những điều giản dị.</h1><p>Không phải cẩm nang đặt dịch vụ. Đây là một lớp bản đồ cảm xúc để bạn biết mình muốn nhìn, nghe và nếm gì ở Ba Động.</p></div></section>
<section class="page-section surface-sand"><div class="container-wide editorial-split"><div class="editorial-split__copy"><p class="eyebrow">Bối cảnh</p><h2>Biển, đồng bằng và một nhịp sống khác.</h2><p>Ba Động nằm trong không gian ven biển Trà Vinh, nơi đường bờ gặp những lớp cây, ruộng và cộng đồng sinh sống lâu đời. Một chuyến đi đến đây không cần phải đầy điểm check-in; chỉ cần đủ thời gian để quan sát.</p><p>Ảnh địa điểm trên website chỉ được công bố khi có trang nguồn và giấy phép rõ ràng. Các chủ đề chưa có ảnh phù hợp được đánh dấu chờ xác minh thay vì dùng ảnh của nơi khác.</p></div><div class="editorial-split__image"><img src="images/locations/ba-dong-beach-1600.jpg" srcset="images/locations/ba-dong-beach-800.jpg 960w, images/locations/ba-dong-beach-1600.jpg 1920w" sizes="(max-width: 820px) 88vw, 45vw" alt="Biển Ba Động với bãi cát, đường ven biển và điện gió ngoài khơi" loading="lazy" decoding="async" width="1600" height="900" /><a class="image-credit" href="https://commons.wikimedia.org/wiki/File:Bi%E1%BB%83n_Ba_%C4%90%E1%BB%99ng,_Tr%C3%A0_Vinh.jpg" target="_blank" rel="noreferrer">Baoothersks · CC BY 4.0 ↗</a></div></div></section>
<section class="page-section surface-foam"><div class="container-wide"><div class="section-heading"><p class="eyebrow">Ba lớp để giữ lại</p><h2>Điểm đến không chỉ là một bức ảnh.</h2></div><div class="feature-grid"><article class="feature-card"><span class="feature-card__number">01</span><h3>Thiên nhiên</h3><p>Nhìn đường bờ như một hệ sinh thái: nước, cây, cát và những vùng đệm cần được bảo vệ.</p></article><article class="feature-card"><span class="feature-card__number">02</span><h3>Cộng đồng</h3><p>Quan sát với sự tôn trọng, xin phép khi chụp ảnh và nhớ rằng đây là không gian sống.</p></article><article class="feature-card"><span class="feature-card__number">03</span><h3>Ẩm thực</h3><p>Hỏi về mùa vụ, nguồn gốc và dị ứng thay vì tìm một danh sách giá thiếu kiểm chứng.</p></article></div></div></section>
<section class="page-section surface-sand"><div class="container-wide"><div class="section-heading"><p class="eyebrow">Định hướng</p><h2>Nhìn Ba Động từ một điểm đứng vừa đủ.</h2><p>Vị trí và đường đi có thể thay đổi theo thời điểm. Hãy mở bản đồ, kiểm tra tuyến thực tế và ưu tiên hướng dẫn địa phương khi cần.</p></div><div class="location-card"><div class="location-card__map" role="img" aria-label="Minh họa khu vực ven biển Ba Động"></div><div><h2>Biển Ba Động</h2><p>@siteInfo.AdministrativeLocation</p><a class="button button--dark" href="@siteInfo.MapUrl" target="_blank" rel="noreferrer">Mở trong Google Maps <span aria-hidden="true">↗</span></a><p class="source-note" style="margin-top:20px">Cập nhật nội dung: @siteInfo.UpdatedAt</p></div></div></div></section>
<section class="page-section surface-ocean"><div class="container-wide"><div class="section-heading"><p class="eyebrow">Tôn trọng nơi chốn</p><h2>Đi nhẹ qua một vùng đất đang sống.</h2><p>Không để lại rác, không tự ý vào khu vực hạn chế, không biến đời sống của người khác thành phông nền. Một trải nghiệm đẹp cũng là một trải nghiệm có trách nhiệm.</p></div><SourceNote Urls="sourceUrls" /></div></section>

@code {
    private readonly IReadOnlyList<Breadcrumbs.BreadcrumbItem> breadcrumbs = [new("Giới thiệu")];
    private SiteInfo siteInfo = new();
    private readonly IReadOnlyList<string> sourceUrls = ["https://vietnamtourism.gov.vn/", "https://travinh.gov.vn/"];
    protected override async Task OnInitializedAsync() => siteInfo = await Content.GetSiteInfoAsync();
}
