@page "/kham-pha"
@inject ContentService Content
<HeadContent><title>Khám phá · BA ĐỘNG — Coastal Escape</title><meta name="description" content="Tìm và lọc các địa điểm, trải nghiệm và lát cắt ven biển Ba Động." /></HeadContent>
<section class="page-hero"><div class="container-wide"><Breadcrumbs Items="breadcrumbs" /><p class="eyebrow">Khám phá</p><h1>Chọn một hướng đi.</h1><p>Tìm theo tên, mô tả hoặc nhóm trải nghiệm. Không có xếp hạng sao, chỉ có những gợi ý để bạn bắt đầu.</p></div></section>
<section class="page-section surface-sand"><div class="container-wide">
    <div class="toolbar"><label class="search-box"><span class="visually-hidden">Tìm kiếm địa điểm</span><input @bind="searchTerm" @bind:event="oninput" type="search" placeholder="Tìm kiếm địa điểm, từ khóa…" aria-label="Tìm kiếm địa điểm" /><span class="search-box__icon" aria-hidden="true">⌕</span></label><span class="result-count">@filteredDestinations.Count() kết quả</span></div>
    <div class="filters" role="group" aria-label="Lọc theo danh mục"><button class="filter-chip @(activeCategory == "all" ? "is-active" : string.Empty)" aria-pressed="@(activeCategory == "all" ? "true" : "false")" @onclick="ResetCategory">Tất cả</button>@foreach (var category in categories) { <button class="filter-chip @(activeCategory == category.Key ? "is-active" : string.Empty)" aria-pressed="@(activeCategory == category.Key ? "true" : "false")" @onclick="() => SetCategory(category.Key)">@category.Value</button> }</div>
    <div style="height:28px"></div>
    @if (!filteredDestinations.Any())
    {
        <div class="empty-state"><h2>Không tìm thấy địa điểm phù hợp.</h2><p>Thử một từ khóa khác hoặc xóa bộ lọc để mở lại toàn bộ câu chuyện.</p><button class="button button--outline" @onclick="ResetFilters">Xóa bộ lọc</button></div>
    }
    else
    {
        <h2 class="visually-hidden">Danh sách địa điểm</h2><div class="card-grid">@foreach (var destination in filteredDestinations) { <DestinationCard Destination="destination" /> }</div>
    }
</div></section>
<section class="page-section surface-foam"><div class="container-wide"><div class="section-heading"><p class="eyebrow">Gợi ý nhỏ</p><h2>Đi bằng sự tò mò, không phải checklist.</h2><p>Mỗi thẻ có nguồn tham khảo và ngày cập nhật. Những chi tiết dễ thay đổi nên được kiểm tra lại trước chuyến đi.</p></div><NavLink class="button button--dark" href="cam-nang">Mở cẩm nang chuẩn bị</NavLink></div></section>

@code {
    private readonly IReadOnlyList<Breadcrumbs.BreadcrumbItem> breadcrumbs = [new("Khám phá")];
    private readonly Dictionary<string, string> categories = new() { ["thien-nhien"] = "Thiên nhiên", ["van-hoa"] = "Văn hóa", ["check-in"] = "Check-in", ["trai-nghiem"] = "Trải nghiệm" };
    private IReadOnlyList<Destination> destinations = [];
    private string searchTerm = string.Empty;
    private string activeCategory = "all";
    private IEnumerable<Destination> filteredDestinations => destinations.Where(Matches);

    protected override async Task OnInitializedAsync() => destinations = await Content.GetDestinationsAsync();
    private void SetCategory(string category) => activeCategory = category;
    private void ResetFilters() { searchTerm = string.Empty; activeCategory = "all"; }
    private void ResetCategory() => activeCategory = "all";
    private bool Matches(Destination destination)
    {
        if (activeCategory != "all" && !string.Equals(destination.Category, activeCategory, StringComparison.OrdinalIgnoreCase)) return false;
        var query = Normalize(searchTerm);
        if (string.IsNullOrWhiteSpace(query)) return true;
        var haystack = Normalize(string.Join(' ', destination.Name, destination.ShortDescription, destination.Description.FirstOrDefault() ?? string.Empty, string.Join(' ', destination.Tags)));
        return haystack.Contains(query, StringComparison.OrdinalIgnoreCase);
    }
    private static string Normalize(string value) => new string(value.Normalize(System.Text.NormalizationForm.FormD).Where(ch => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(ch) != System.Globalization.UnicodeCategory.NonSpacingMark).ToArray()).Normalize(System.Text.NormalizationForm.FormC).ToLowerInvariant();
}
