<div class="faq-list">
    @foreach (var item in Items)
    {
        var isOpen = openId == item.Id;
        <div class="faq-item"><button class="faq-trigger" type="button" aria-expanded="@(isOpen ? "true" : "false")" aria-controls="faq-@item.Id" @onclick="() => Toggle(item.Id)"><span>@item.Question</span><span aria-hidden="true">@(isOpen ? "−" : "+")</span></button>@if (isOpen) { <div id="faq-@item.Id" class="faq-answer">@item.Answer<SourceNote Urls="item.SourceUrls" /></div> }</div>
    }
</div>
@code { [Parameter] public IReadOnlyList<FaqItem> Items { get; set; } = []; private string? openId; private void Toggle(string id) => openId = openId == id ? null : id; }
