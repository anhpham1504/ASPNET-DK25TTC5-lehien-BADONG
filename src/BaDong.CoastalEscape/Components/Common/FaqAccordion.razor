<div class="faq-list">
    @foreach (var item in Items)
    {
        var isOpen = openId == item.Id;
        <div class="faq-item"><button id="faq-trigger-@item.Id" class="faq-trigger" type="button" aria-expanded="@(isOpen ? "true" : "false")" aria-controls="faq-@item.Id" @onclick="() => Toggle(item.Id)"><span>@item.Question</span><span aria-hidden="true">@(isOpen ? "−" : "+")</span></button><div id="faq-@item.Id" class="faq-answer" role="region" aria-labelledby="faq-trigger-@item.Id" hidden="@(!isOpen)">@item.Answer<SourceNote Urls="item.SourceUrls" /></div></div>
    }
</div>
@code { [Parameter] public IReadOnlyList<FaqItem> Items { get; set; } = []; private string? openId; private void Toggle(string id) => openId = openId == id ? null : id; }
